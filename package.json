{
  "name": "pta-cashiering-system",
  "version": "1.0.0",
  "private": true,
  "description": "Electron-ready PTA Cashiering System",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "backend": "cd Backend && npm run dev"
  },
  "author": "PTA Cashiering System",
  "dependencies": {},
  "devDependencies": {
    "electron": "42.1.0",
    "electron-builder": "^26.8.1"
  },
  "build": {
    "appId": "com.yourapp.system",
    "productName": "PTA Cashiering System",
    "files": [
      "Backend/**/*",
      "Frontend/**/*",
      "main.js",
      "package.json"
    ],
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "win": {
      "target": "nsis",
      "signAndEditExecutable": false
    }
  }
}
